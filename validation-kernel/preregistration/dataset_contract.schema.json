{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "datasets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_tests": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "available_observables": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "blindness_level": {
            "enum": [
              "BLIND_STRICT",
              "BLIND_PARTIAL",
              "NON_BLIND_HISTORICAL",
              "FUTURE_BLIND"
            ]
          },
          "contract": {
            "type": "object"
          },
          "count_semantics": {
            "type": "string"
          },
          "covariance_availability": {
            "type": "string"
          },
          "dataset_id": {
            "type": "string"
          },
          "experiment": {
            "type": "string"
          },
          "exposure_classification": {
            "enum": [
              "MODEL_PREEXISTING",
              "MODEL_EXPOSED",
              "POST_DATA_MODEL_CHANGE",
              "UNKNOWN_EXPOSURE"
            ]
          },
          "geometry_availability": {
            "type": "string"
          },
          "known_limitations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "local_path": {
            "pattern": "^(?!/)(?!.*\\.\\.).+$",
            "type": "string"
          },
          "number_of_objects": {
            "minimum": 0,
            "type": "integer"
          },
          "orientation_availability": {
            "type": "string"
          },
          "prohibited_tests": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "provenance_status": {
            "type": "string"
          },
          "quality_grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "raw_or_derived": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_dois": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source_reference": {
            "type": "string"
          },
          "timing_resolution": {
            "type": "string"
          },
          "uncertainties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "validation_role": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "experiment",
          "source_dois",
          "source_reference",
          "local_path",
          "sha256",
          "version",
          "quality_grade",
          "raw_or_derived",
          "number_of_objects",
          "count_semantics",
          "available_observables",
          "uncertainties",
          "covariance_availability",
          "timing_resolution",
          "geometry_availability",
          "orientation_availability",
          "validation_role",
          "allowed_tests",
          "prohibited_tests",
          "known_limitations",
          "provenance_status",
          "exposure_classification",
          "blindness_level",
          "contract"
        ],
        "type": "object"
      },
      "minItems": 13,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source_of_truth": {
      "const": "ValidationDatasetRegistry"
    }
  },
  "required": [
    "schema_version",
    "source_of_truth",
    "datasets"
  ],
  "title": "ValidationDatasetRegistry",
  "type": "object"
}
