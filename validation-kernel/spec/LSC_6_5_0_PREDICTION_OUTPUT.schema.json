{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lsc/6.5.0/prediction-output.schema.json",
  "title": "LSC 6.5.0 exact finite-dilation prediction output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_version", "model_profile", "model_sha256", "model_state", "scientific_specification_sha256", "scientific_freeze_sha256", "parameter_sha256", "cross_section_payload_sha256", "source_line_payload_sha256", "input_sha256", "input_classification", "experiment_id", "observation_id", "source_isotope", "alpha_0", "alpha_domain_closed_for_input", "per_line", "baseline_denominator", "exact_numerator", "R_pred", "applicable_domain_status", "anisotropic_sector", "warnings", "blockers", "provenance_references", "analysis_context"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_version": {"const": "6.5.0"},
    "model_profile": {"const": "EXACT_FINITE_A2/C/A"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_state": {"enum": ["PREFIT_SCIENTIFIC_FREEZE", "FROZEN_PARAMETER_BUNDLE"]},
    "scientific_specification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scientific_freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parameter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cross_section_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_line_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_classification": {"type": "string"},
    "experiment_id": {"type": "string"},
    "observation_id": {"type": "string"},
    "source_isotope": {"type": "string"},
    "alpha_0": {"type": "number"},
    "alpha_domain_closed_for_input": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "per_line": {"type": "array", "minItems": 1},
    "baseline_denominator": {"type": "number", "exclusiveMinimum": 0.0},
    "exact_numerator": {"type": "number", "exclusiveMinimum": 0.0},
    "R_pred": {"type": "number", "exclusiveMinimum": 0.0},
    "applicable_domain_status": {"const": "PASS"},
    "anisotropic_sector": {"const": "DISABLED"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "provenance_references": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "analysis_context": {"type": "object"}
  }
}
