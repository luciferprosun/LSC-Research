{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lsc/6.5.0/prediction-input.schema.json",
  "title": "LSC 6.5.0 exact finite-dilation prediction input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_version", "model_profile", "response_variant", "cross_section_scenario_id", "source_line_payload_sha256", "input_classification", "experiment_id", "observation_id", "source_isotope", "alpha_0", "parameter_source", "lines", "analysis_context"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model_version": {"const": "6.5.0"},
    "model_profile": {"const": "EXACT_FINITE_A2/C/A"},
    "response_variant": {"const": "EXACT_CAPTURE_ARGUMENT_DILATION"},
    "cross_section_scenario_id": {"const": "BAHCALL_1997_BEST_ESTIMATE_NATURAL_CUBIC_SPLINE"},
    "source_line_payload_sha256": {"const": "ecfd559f0ccbb5da7040b42d73f2abc2c49a0637993964c621f6e145da70c70e"},
    "input_classification": {"enum": ["AUTHORIZED_SOURCE_INPUT", "NON_PHYSICAL_TEST_FIXTURE"]},
    "experiment_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "source_isotope": {"enum": ["Cr51", "Ar37", "NON_PHYSICAL_TEST_FIXTURE"]},
    "alpha_0": {"type": "number", "minimum": -0.5747389495096434, "maximum": 3.607238025076703},
    "parameter_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bundle_sha256"],
      "properties": {
        "kind": {"enum": ["NON_PHYSICAL_TEST_FIXTURE", "PREFIT_AUTHORIZED_DEVELOPMENT", "FROZEN_PARAMETER_BUNDLE"]},
        "bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "energy_mev", "branching_fraction", "source_activity_bq", "exposure_seconds", "conventional_probability", "geometry_factor", "detector_efficiency"],
        "properties": {
          "line_id": {"type": "string", "minLength": 1},
          "energy_mev": {"type": "number", "minimum": 0.24, "maximum": 30.0},
          "branching_fraction": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
          "source_activity_bq": {"type": "number", "exclusiveMinimum": 0.0},
          "exposure_seconds": {"type": "number", "exclusiveMinimum": 0.0},
          "conventional_probability": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0},
          "geometry_factor": {"type": "number", "exclusiveMinimum": 0.0},
          "detector_efficiency": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "analysis_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "covariance_scenario_id", "nuisance_policy_id", "observed_outcomes_included", "BEST2_observed_data_accessed"],
      "properties": {
        "role": {"enum": ["PREDICTION_ONLY", "DEVELOPMENT_DATA", "RETROSPECTIVE_SMOKE", "NON_PHYSICAL_TEST"]},
        "covariance_scenario_id": {"type": "string", "minLength": 1},
        "nuisance_policy_id": {"type": "string", "minLength": 1},
        "observed_outcomes_included": {"const": false},
        "BEST2_observed_data_accessed": {"const": false}
      }
    }
  }
}
